{
  "name": "outstand-query-loop-dedup",
  "version": "1.2.0",
  "description": "Prevents duplicate posts across multiple Query Loop blocks on the same page.",
  "contributors": [
    {
      "name": "S\u00e9rgio Santos",
      "homepage": "https://s3rgiosan.dev"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pixelalbatross/outstand-query-loop-dedup"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "packages-update": "wp-scripts packages-update",
    "lint:js": "wp-scripts lint-js",
    "lint:js:fix": "wp-scripts lint-js --fix",
    "lint:css": "wp-scripts lint-style",
    "format": "wp-scripts format",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:pot": "wp i18n make-pot . languages/outstand-query-loop-dedup.pot --exclude=src",
    "translate:update": "wp i18n update-po languages/outstand-query-loop-dedup.pot languages/*.po",
    "translate:compile": "npm run translate:mo && npm run translate:js",
    "translate:js": "wp i18n make-json languages --no-purge",
    "translate:mo": "wp i18n make-mo languages languages",
    "wp-env": "wp-env",
    "wp-env:clean": "wp-env clean all",
    "test:setup": "npm run wp-env start",
    "test:unit": "wp-env run tests-cli --env-cwd='wp-content/plugins/outstand-query-loop-dedup' vendor/bin/phpunit --testsuite=default",
    "test:js": "wp-scripts test-unit-js"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@wordpress/block-editor": "^14.18.0",
    "@wordpress/blocks": "^14.10.0",
    "@wordpress/components": "^30.9.0",
    "@wordpress/compose": "^7.36.0",
    "@wordpress/core-data": "^7.36.0",
    "@wordpress/data": "^10.36.0",
    "@wordpress/element": "^6.36.0",
    "@wordpress/hooks": "^4.36.0",
    "@wordpress/i18n": "^6.9.0"
  },
  "devDependencies": {
    "@wordpress/env": "^10.36.0",
    "@wordpress/scripts": "^30.12.0"
  }
}
